{
  "name": "@medicn/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "worker:email": "ts-node src/email/email.worker.ts",
    "worker:outbox": "ts-node src/jobs/outbox.worker.ts",
    "worker:media": "ts-node src/media/media.worker.ts",
    "worker:maps": "ts-node src/maps/maps.worker.ts",
    "worker:operations": "ts-node src/operations/operations.worker.ts",
    "jobs:recover": "ts-node src/operations/jobs-recover.ts",
    "jobs:requeue": "ts-node src/operations/jobs-requeue.ts",
    "payments:reconcile": "ts-node src/operations/payments-reconcile.ts",
    "host-transfers:reconcile": "ts-node src/operations/host-transfers-reconcile.ts",
    "maps:retry": "ts-node src/maps/maps-retry.ts",
    "maps:refresh": "ts-node src/maps/maps-refresh.ts",
    "media:retry": "ts-node src/media/media-retry.ts",
    "media:cleanup": "ts-node src/media/media-cleanup.ts",
    "smoke:email": "ts-node src/email/email-smoke.ts",
    "admin:grant": "ts-node src/admin/grant-admin.ts",
    "openapi:generate": "npm run build && node dist/openapi/openapi-generate.js --write",
    "openapi:check": "npm run build && node dist/openapi/openapi-generate.js --check",
    "query-plans:audit": "npm run build && node dist/operations/query-plan-audit.js --write",
    "smoke:http": "ts-node test/http-load-smoke.ts",
    "payments:webhook-retry": "ts-node src/payments/webhook-retry.ts",
    "payments:expire-checkouts": "ts-node src/payments/checkout-expiry.ts",
    "payments:release-host-transfers": "ts-node src/payments/host-transfer-release.ts",
    "identity:webhook-retry": "ts-node src/identity/webhook-retry.ts",
    "email:webhook-retry": "ts-node src/email/email-webhook-retry.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@medicn/types": "file:../../packages/types",
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "2.108.2",
    "bullmq": "^5.79.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.2.0",
    "prom-client": "15.1.3",
    "redis": "^5.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "socket.io": "^4.8.3",
    "stripe": "22.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.27",
    "@types/express": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.2",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "eslint": "10.5.0",
    "jest": "30.4.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
