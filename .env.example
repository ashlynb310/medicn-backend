# Browser-safe variables only. Never put backend-only secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=

# UI rollout guard for the healthcare credential evidence workflow.
# Frontend-only switch; backend authorization remains authoritative. Enabling it
# does NOT mean public-production evidence collection is approved. Set to "true"
# in a local, ignored .env.local for testing.
NEXT_PUBLIC_HEALTHCARE_EVIDENCE_ENABLED=false
