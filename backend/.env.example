# App
NODE_ENV=development
PORT=4100
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
ALLOWED_ORIGINS=http://localhost:3000
# Number of trusted reverse-proxy hops. Keep 0 unless the deployment topology is
# known and fixed; this controls the client IP used for security decisions.
TRUST_PROXY_HOPS=0
# Production validation requires this to be true and REDIS_URL to be configured.
RATE_LIMITING_ENABLED=false
# API documentation is public in non-production only. Production documentation
# is disabled unless explicitly enabled and protected by this dedicated token.
OPENAPI_ENABLED=false
OPENAPI_BEARER_TOKEN=

# Auth and Storage - Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=listing-photos

# Product media processing. Create these buckets in the Supabase Dashboard;
# media-ingest must be private, derivative buckets may be public.
MEDIA_PROCESSING_ENABLED=false
MEDIA_MAX_INPUT_BYTES=5242880
MEDIA_MAX_INPUT_PIXELS=40000000
MEDIA_MAX_DIMENSION=12000
MEDIA_PROCESSING_CONCURRENCY=2
MEDIA_INGEST_RETENTION_HOURS=24
SUPABASE_MEDIA_INGEST_BUCKET=media-ingest
SUPABASE_LISTING_MEDIA_BUCKET=listing-photos
SUPABASE_PROFILE_MEDIA_BUCKET=profile-photos
SUPABASE_HEALTHCARE_EVIDENCE_BUCKET=healthcare-credentials
HEALTHCARE_EVIDENCE_MAX_INPUT_BYTES=10485760
HEALTHCARE_EVIDENCE_VIEW_URL_TTL_SECONDS=60
HEALTHCARE_EVIDENCE_DELETION_MAX_ATTEMPTS=5

# Database
DATABASE_URL=postgresql://medicn:medicn_dev_password@localhost:5432/medicn_dev?schema=public
POSTGRES_USER=medicn
POSTGRES_PASSWORD=medicn_dev_password
POSTGRES_DB=medicn_dev
POSTGRES_PORT=5432

# Redis / workers
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_KEY_PREFIX=medicn
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRY_DELAY_MS=10000
# Socket.IO messaging uses the same Redis deployment with a dedicated adapter key.
MESSAGING_MAX_SOCKETS_PER_USER=5
MESSAGING_MAX_SOCKET_CONNECTIONS=10000
MESSAGING_PING_INTERVAL_MS=25000
MESSAGING_PING_TIMEOUT_MS=20000
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_CLAIM_LEASE_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_STALE_MS=60000
OPERATIONS_SCHEDULER_ENABLED=false
OPERATIONS_RECOVERY_INTERVAL_MS=60000
OPERATIONS_MAINTENANCE_INTERVAL_MS=300000
OPERATIONS_METRICS_ENABLED=false
OPERATIONS_METRICS_TOKEN=

# Veriff
VERIFF_ENABLED=false
VERIFF_API_BASE_URL=
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_CALLBACK_URL=

# Stripe
# Cancellation expiry/refund work is backend-only and runs through
# worker:outbox -> worker:operations. Keep disabled without configured workers,
# webhook reconciliation, and Stripe test-mode validation.
PAYMENTS_ENABLED=false
STRIPE_CONNECT_ENABLED=false
PLATFORM_FEE_BPS=
HOST_TRANSFER_DELAY_HOURS=
CHECKOUT_SESSION_TTL_MINUTES=30
PAYMENTS_OPERATIONS_EMAIL=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Maps
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
MAPS_ENABLED=false
MAPS_LOCATION_PRIVACY_SECRET=
MAPS_PROVIDER_TIMEOUT_MS=5000
MAPS_NEARBY_RADIUS_METERS=5000
MAPS_MAX_NEARBY_PER_CATEGORY=5
MAPS_NEARBY_CACHE_TTL_HOURS=720
MAPS_ROUTE_CACHE_TTL_HOURS=168
MAPS_WORKER_CONCURRENCY=2
MAPS_PUBLIC_DISTANCE_ROUNDING_METERS=100

# Transactional Email
EMAIL_PROVIDER=local
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_FROM=
BREVO_API_KEY=
BREVO_WEBHOOK_BEARER_TOKEN=
EMAIL_PROVIDER_TIMEOUT_MS=5000

# Administrative bootstrap (required only when running admin:grant in production)
ALLOW_ADMIN_BOOTSTRAP=false
